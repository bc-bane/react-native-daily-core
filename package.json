{
  "name": "react-native-daily-core",
  "private": true,
  "//": "^ COMMENT OUT 'private: true' BEFORE RUNNING NPM PUBLISH",
  "version": "0.1.0",
  "description": "React Native CallClient for Daily, built on the iOS and Android SDKs",
  "main": "dist/index.js",
  "react-native": "src/index.ts",
  "types": "dist/index.d.ts",
  "codegenConfig": {
    "name": "DailyCallClientSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.daily.reactlibrary"
    },
    "ios": {
      "componentProvider": {
        "DailyVideoView": "DailyVideoView"
      }
    }
  },
  "files": [
    "dist",
    "android/src",
    "android/build.gradle",
    "android/gradle.properties",
    "ios",
    "react-native-daily-core.podspec",
    "react-native.config.js",
    "app.plugin.js",
    "MIGRATION.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest",
    "build": "rm -rf dist/ && tsc",
    "prepare": "npm run build",
    "tag": "scripts/tag",
    "prepublishOnly": "npm run tag"
  },
  "license": "BSD-2-Clause",
  "engines": {
    "node": ">=20.19.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bc-bane/react-native-daily-core.git",
    "baseUrl": "https://github.com/bc-bane/react-native-daily-core"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.82.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.1",
    "jest": "^29.6.3",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  }
}
