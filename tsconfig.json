{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "outDir": "./dist",
    "lib": ["es2021"],
    "strict": true,
    "jsx": "react-native",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "skipLibCheck": true,
    "types": ["react", "react-native"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
